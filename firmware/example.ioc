# --- BAJA SAE DAQ HARDWARE PIN MAPPING ---
# System Clocks (8MHz Crystal)
PH0-OSC_IN.Signal=RCC_OSC_IN
PH1-OSC_OUT.Signal=RCC_OSC_OUT

# RPM Input Captures (TIM2)
PA0-WKUP.Mode=Input_Capture
PA0-WKUP.Signal=S_TIM2_CH1
PA1.Mode=Input_Capture
PA1.Signal=S_TIM2_CH2

# Suspension ADCs
PA2.Signal=ADCx_IN2
PA3.Signal=ADCx_IN3

# SPI1 (IMU)
PA5.Mode=SPI_Master
PA5.Signal=SPI1_SCK
PA6.Mode=SPI_Master
PA6.Signal=SPI1_MISO
PA7.Mode=SPI_Master
PA7.Signal=SPI1_MOSI
PB1.Locked=true
PB1.Signal=GPIO_Output
PB1.GPIO_Label=IMU_CS

# I2C1 (Belt Temp)
PB6.Mode=I2C
PB6.Signal=I2C1_SCL
PB7.Mode=I2C
PB7.Signal=I2C1_SDA

# CAN1 (Dashboard Broadcast)
PB8.Mode=CAN_Activate
PB8.Signal=CAN1_RX
PB9.Mode=CAN_Activate
PB9.Signal=CAN1_TX

# SDIO (MicroSD Card - 4-bit Mode)
PC8.Mode=SD_4_bits_Wide_bus
PC8.Signal=SDIO_D0
PC9.Mode=SD_4_bits_Wide_bus
PC9.Signal=SDIO_D1
PC10.Mode=SD_4_bits_Wide_bus
PC10.Signal=SDIO_D2
PC11.Mode=SD_4_bits_Wide_bus
PC11.Signal=SDIO_D3
PC12.Mode=SD_4_bits_Wide_bus
PC12.Signal=SDIO_CK
PD2.Mode=SD_4_bits_Wide_bus
PD2.Signal=SDIO_CMD

# MCU Specifics
VP_SYS_VS_Systick.Mode=SysTick
VP_SYS_VS_Systick.Signal=SYS_VS_Systick
VP_TIM2_VS_ClockSourceINT.Mode=Internal
VP_TIM2_VS_ClockSourceINT.Signal=TIM2_VS_ClockSourceINT